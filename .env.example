# In Vercel unter Project → Settings → Environment Variables eintragen (alle Environments).

# Airtable Personal Access Token (airtable.com/create/tokens)
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
# Zugriff: die Base "Baustelle App"
AIRTABLE_TOKEN=pat_XXXXXXXXXXXX

# Base-ID: in Airtable die Base öffnen – die ID steht in der URL (beginnt mit "app")
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Web-Push-Schlüssel: einmalig erzeugen mit  `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=BXXXXXXXX...
VAPID_PRIVATE_KEY=XXXXXXXX...
VAPID_MAIL=info@deine-firma.de

# Frei wählbares Geheimnis: schützt /api/setup und die Cron-/Hook-Endpunkte (?secret=…)
SETUP_SECRET=bitte-etwas-langes-eigenes

# Vercel schickt dieses Geheimnis automatisch bei Cron-Aufrufen mit (Authorization: Bearer …)
CRON_SECRET=noch-ein-eigenes-geheimnis

# Geheimnis für Airtable-Automationen (steht im Automations-Skript): darf nur Push-Endpunkte auslösen, nicht /api/setup
HOOK_SECRET=drittes-eigenes-geheimnis

# Firmenname für den Kopf des Stundenzettels
FIRMA_NAME=Muster Bau GmbH

# Optional: Alarm-Mails bei Serverfehlern (Resend, kostenloses Kontingent) – wie bei Wunschlos
# RESEND_API_KEY=re_XXXX
# ALERT_EMAIL=denis@sprach-ki.live
# ALERT_FROM=Baustellen-App <onboarding@resend.dev>

# Für die App sichtbarer Public-Key (identisch zu VAPID_PUBLIC_KEY!)
VITE_VAPID_PUBLIC_KEY=BXXXXXXXX...

# --- seit V1.5 (optional) ---
# Zusatzmodule je Paket (leer = tagesbericht + export): tagesbericht = Tagesbericht mit Unterschrift, export = Lohn-Export,
# uebersetzung = Büro-Texte über Claude/Vercel AI Gateway übersetzen (nur wenn ausdrücklich eingetragen)
MODULE=
# Nur falls nötig – sonst meldet sich das Deployment per Vercel-OIDC beim AI Gateway an:
# AI_GATEWAY_API_KEY=
# UEBERSETZUNG_MODELL=anthropic/claude-haiku-5.5
# Nur für die DATEV-Datei im Lohn-Export (Nummern vom Steuerbüro; erster Import als Test mit dem Steuerbüro)
DATEV_BERATERNR=
DATEV_MANDANTENNR=
DATEV_LA_ARBEIT=
DATEV_LA_FAHRZEIT=
DATEV_LA_RUESTZEIT=
DATEV_BS_STUNDEN=1
