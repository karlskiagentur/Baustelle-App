{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_hinweis": "Nach dem Kunden-Go (Vercel Pro): diese Datei nach vercel.json kopieren. Pro erlaubt minutengenaue und mehrfach tägliche Crons.",
  "crons": [
    { "path": "/api/cron/einsatz-push", "schedule": "30 15 * * *" },
    { "path": "/api/cron/stempel-erinnerung", "schedule": "45 4 * * 1-5" },
    { "path": "/api/cron/dokument-push", "schedule": "*/10 6-19 * * 1-6" },
    { "path": "/api/cron/stundenzettel", "schedule": "0 4 1 * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
